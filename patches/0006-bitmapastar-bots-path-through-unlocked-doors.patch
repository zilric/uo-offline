-            if (bc != null)
-            {
-                MoveImpl.AlwaysIgnoreDoors = bc.CanOpenDoors;
-                MoveImpl.IgnoreMovableImpassables = bc.CanMoveOverObstacles;
-            }
+            //
+            // Driven from the resolved per-mobile fields, NOT from `bc`. The
+            // cache path below was taught about PlayerBots (see where
+            // _currentMobileIgnoreDoors is set) but this line was left gated
+            // on BaseCreature, so a bot kept its door-ignoring only for as
+            // long as the step cache could answer. A cache MISS falls through
+            // to GetSuccessorsSlowPath, which reads these statics — and with
+            // them unset every closed door went back to being a solid wall.
+            // Dungeon interiors are precisely where the cache misses, which
+            // is why bots still shuffled at dungeon doors after the cache
+            // path was fixed.
+            MoveImpl.AlwaysIgnoreDoors = _currentMobileIgnoreDoors;
+            MoveImpl.IgnoreMovableImpassables = _currentMobileIgnoreMovableImpassables;
 
             MoveImpl.Goal = goal;
 
